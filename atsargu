    const xs=SVG_XS.slice(0,pts.length);
    document.getElementById(pid).setAttribute('points',xs.map((x,i)=>x+','+toY(pts[i].kiekis)).join(' ')||'0,178');
    document.getElementById(did).innerHTML=xs.map((x,i)=>`<circle cx="${x}" cy="${toY(pts[i].kiekis)}" r="3.5" fill="${col}"/>`).join('');
  }
  buildLine(gav,'#1DB88A','svgGauta','svgGautaDots');
  buildLine(isd,'#7ADCC8','svgIsduota','svgIsduotaDots');
  p3updateClear();
}

